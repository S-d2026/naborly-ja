# ============================================================
# NABERLY JA — ENVIRONMENT VARIABLES
# 1. Copy this file and rename it .env.local in your project root
# 2. Fill in your real values from Supabase dashboard
# 3. Never commit .env.local to GitHub
# ============================================================

# --- Supabase ---
# Find these in: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE

# --- Naberly Config ---
NEXT_PUBLIC_SITE_URL=https://naberlyja.com
NEXT_PUBLIC_NABERLY_WHATSAPP=+19174432797
NEXT_PUBLIC_APP_NAME=Naberly JA

# --- Admin WhatsApp relay ---
# This is the number all anonymous messages route through
NABERLY_RELAY_WHATSAPP=+19174432797
